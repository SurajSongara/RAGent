FROM python:3.12-slim

# System deps for PDF rasterising and OCR. Kept explicit rather than pulling a
# fat prebuilt image so the build stays auditable.
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils \
        tesseract-ocr \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --upgrade pip && pip install -e ".[dev]"

COPY ragent ./ragent
COPY evals ./evals

CMD ["uvicorn", "ragent.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
