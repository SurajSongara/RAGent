# Copy to .env and fill in. Everything works offline with EMBEDDING_BACKEND=local;
# API keys are only needed for the generation, contextualise and figure-caption stages.

# --- models -------------------------------------------------------------
# auto      pick whichever provider has credentials, preferring Anthropic
# anthropic | openai | none   (none forces the extractive fallback)
LLM_PROVIDER=auto

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_SYNTHESIS=claude-opus-5
MODEL_UTILITY=claude-haiku-4-5
MODEL_VISION=claude-sonnet-5

# --- OpenAI-compatible ---
# Works with OpenAI, Azure OpenAI, Ollama, vLLM, Groq, Together, OpenRouter and
# LM Studio. Only OPENAI_BASE_URL changes between them; local servers need no key.
#   Ollama   http://localhost:11434/v1
#   vLLM     http://localhost:8000/v1
#   Groq     https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_SYNTHESIS=gpt-4o
OPENAI_MODEL_UTILITY=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# --- embeddings ---
# local  -> fastembed (bge-small), runs in-process, no key, no network
# openai -> any OpenAI-compatible /embeddings endpoint, via OPENAI_BASE_URL
# voyage -> voyage-3 hosted embeddings, needs VOYAGE_API_KEY
EMBEDDING_BACKEND=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=

# --- ingest -------------------------------------------------------------
PIPELINE_VERSION=v1
OCR_CONFIDENCE_THRESHOLD=0.72
CHUNK_STRATEGIES=layout,recursive,fixed,semantic
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- retrieval ----------------------------------------------------------
RETRIEVAL_TOP_K=50
RERANK_TOP_N=8
RRF_K=60
SEMANTIC_CACHE_THRESHOLD=0.96

LOG_LEVEL=INFO
